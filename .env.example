# Copy this file to .env and fill in your own values. Never commit .env or share it.
# In production (Render), set these in the dashboard instead; render.yaml lists them.

# Required
ANTHROPIC_API_KEY=
JEV_API_KEY=

# "Continue with Google" sign-in (the only way to make an account). From Google Cloud Console > ClariTale >
# Clients. In development open the app at http://localhost:5173 (not 127.0.0.1): that redirect URI is registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback   (default: this server's own callback URL)

# Production only (Render sets these for you): JWT_SECRET must be 32+ characters
# ENV=production
# JWT_SECRET=
# DATABASE_URL=postgres://...
# RATELIMIT_STORAGE_URI=redis://...

# Optional limits (defaults shown)
# FREE_DAILY_GENERATIONS=10
# FREE_DAILY_USD=0.25
# GLOBAL_DAILY_USD=10
# NETWORK_DAILY_USD=2
# NETWORK_DAILY_SIGNUPS=20

# Extra web addresses allowed to call the API (the app's own address is always allowed)
# ALLOWED_ORIGINS=https://example.com

# Development only: never set these in production
# ALLOW_DEBUG=1
# ALLOW_HIDDEN_MODES=1
# PASSWORD_AUTH=1      turn email + password sign-up and sign-in back on (tests use it)

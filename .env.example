# Copy this file to .env and fill in your own values. Never commit .env or share it.
# In production (Render), set these in the dashboard instead; render.yaml lists them.

# Required
ANTHROPIC_API_KEY=
JEV_API_KEY=

# "Continue with Google" sign-in (the only way to make an account). From Google Cloud Console > ClariTale >
# Clients. In development open the app at http://localhost:5173 (not 127.0.0.1): that redirect URI is registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback   (default: this server's own callback URL)

# Production only (Render sets these for you): JWT_SECRET must be 32+ characters
# ENV=production
# JWT_SECRET=
# DATABASE_URL=postgres://...
# RATELIMIT_STORAGE_URI=redis://...

# Optional limits (defaults shown)
# FREE_DAILY_GENERATIONS=10
# FREE_DAILY_USD=0.25
# GLOBAL_DAILY_USD=10
# NETWORK_DAILY_USD=2
# NETWORK_DAILY_SIGNUPS=20

# Follow-ups v3 (server/explainer/modes/followup/): typed follow-ups on Explorer and Reader pages are read first, then a
# section editor decides what to change. FOLLOWUP_MAX_USD: above this estimated cost the reader is offered cheaper options.
# FOLLOWUP_MAX_USD=0.15
# Follow-ups v4 (modes/followup/v4/): a tool-using editor in place of v3's typed plan, with friendly replies and questions.
# Off until compared with v3 (scripts/followup-live.mjs). FOLLOWUP_MAX_USD also caps one v4 edit's spend.
# FOLLOWUP_V4=1
# Follow-ups v5 (modes/followup/v5/, .claude/followup-v5-plan.md): the version store and main file in front of a tool-using
# editor that can work from any version, plus an after-edit review. The default follow-up (Nov 19 2026): FOLLOWUP_V5=0 falls
# back to v4 (FOLLOWUP_V4=1) or v3. FOLLOWUP_V5_FULLPAGE=0 sends the talk step only the main file, not the page's full text.
# FOLLOWUP_V5_LOOK=0 stops it taking screenshots of Explorer playgrounds (on by default; needs Playwright's Chromium).
# FOLLOWUP_V5=1
# FOLLOWUP_V5_FULLPAGE=1
# FOLLOWUP_V5_LOOK=1
# First message (modes/intake.py): every message that would start a new explainer is read first by one Haiku call, which
# answers in the chat (a question, "what would a page on X cover?", chit-chat, a non-AI topic: no page, not counted) or
# builds from a brief. On by default (Nov 19 2026); FIRST_TALK=0 turns it off (eval: server/evals/intake_eval.py).
# FIRST_TALK=1

# Extra web addresses allowed to call the API (the app's own address is always allowed)
# ALLOWED_ORIGINS=https://example.com

# Development only: never set these in production
# ALLOW_DEBUG=1
# PASSWORD_AUTH=1      turn email + password sign-up and sign-in back on (tests use it)
